---
layout: base.njk
title: Library
permalink: /library/
---
{#- Spine size: set "height" (percent of shelf, about 80 to 99) and/or
    "width" (pixels, about 40 to 70) on a book in library.json to override
    the automatic pattern. -#}
<section class="library">
  <header class="library-intro">
    <h1>Library</h1>
    <p class="library-lede">{{ site.libraryLede }}</p>
  </header>

  <div class="shelf" aria-hidden="true">
    {% for book in library %}
    <a class="spine" href="#{{ book.slug }}" tabindex="-1"
       style="--c: {{ book.colour }}; --h: {{ book.height or ([91, 98, 88, 95][loop.index0 % 4] if book.title.length > 20 else [86, 94, 80, 98, 90, 84][loop.index0 % 6]) }}%; --w: {{ book.width or ([46, 40, 52, 44, 48, 42][loop.index0 % 6] + (18 if book.title.length > 20 else 0)) }}px">
      <span class="spine-title">{{ book.title }}</span>
      <span class="spine-author">{{ book.author | replace(" & ", " · ") }}</span>
    </a>
    {% endfor %}
    <span class="bookend"></span>
  </div>

  <ul class="books">
    {% for book in library %}
    <li class="book" id="{{ book.slug }}" style="--c: {{ book.colour }}">
      <h2 class="book-title">{{ book.title }}</h2>
      {% if book.subtitle %}<p class="book-subtitle">{{ book.subtitle }}</p>{% endif %}
      <p class="book-author">{{ book.author }} · {{ book.year }}</p>
      <p class="book-note">{{ book.note }}</p>
    </li>
    {% endfor %}
  </ul>
</section>
