---
layout: base.njk
---
<section class="hero">
  <h1 class="hero-statement">{{ site.heroStatement | safe }}</h1>
  <p class="hero-sub">{{ site.heroSub | safe }}</p>
</section>

<section class="article-list">
  <h2 class="section-label">Writing</h2>
  <ul>
    {% for article in collections.articles %}
    <li>
      <div class="article-list-meta">
        <time datetime="{{ article.date | isoDate }}">{{ article.date | readableDate }}</time>
        {% if article.data.category %}<span class="tag tag-{{ article.data.category | slugify }}">{{ article.data.category }}</span>{% endif %}
      </div>
      <a class="article-list-title" href="{{ article.url }}">{{ article.data.title }}</a>
      {% if article.data.summary %}<p class="article-list-summary">{{ article.data.summary }}</p>{% endif %}
    </li>
    {% endfor %}
  </ul>
</section>
