<!doctype html>
<html lang="en-GB">
<head>
  {%- set u = page.url or "" -%}
  {%- set isArticle = u.indexOf("/articles/") == 0 -%}
  {%- set ogImage = site.url + ("/assets/og/" + page.fileSlug + ".png" if isArticle else "/assets/og-card.png") -%}
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {{ site.name }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ summary or description or site.description }}">
  <meta name="author" content="{{ site.author }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ summary or site.description }}">
  <meta property="og:image" content="{{ ogImage }}">
  <meta name="twitter:image" content="{{ ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{% if isArticle %}{{ title }}: {{ summary }}{% else %}Dr Richard Grainger: writing on ceramics, composites and the long road from lab bench to flight.{% endif %}">
  <meta property="og:type" content="{% if isArticle %}article{% else %}website{% endif %}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/assets/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="/feed.xml">
</head>
<body>
  <header class="site-header">
    <a class="site-name" href="/"><span class="site-mark" aria-hidden="true">RG</span><span class="site-name-text">{{ site.name }}</span></a>
    <nav class="site-nav" aria-label="Main">
      <a href="/"{% if u == "/" or u.indexOf("/articles/") == 0 %} aria-current="page"{% endif %}>Writing</a>
      <a href="/library/"{% if u == "/library/" %} aria-current="page"{% endif %}>Library</a>
      <a href="/about/"{% if u == "/about/" %} aria-current="page"{% endif %}>About</a>
      <a href="/about/#contact">Contact</a>
    </nav>
  </header>

  <main class="site-main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p>&copy; {% year %} {{ site.author }}</p>
    <p class="site-footer-links">
      <a href="https://www.linkedin.com/in/dr-richard-grainger">LinkedIn</a>
      <a href="{{ site.orcid }}">ORCID</a>
      <a href="/feed.xml">RSS</a>
      <a href="/about/#contact">Contact</a>
    </p>
  </footer>
</body>
</html>
