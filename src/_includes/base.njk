<!doctype html>
<html lang="en-GB">
<head>
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ summary or site.description }}">
  <meta property="og:image" content="https://richard-grainger.co.uk/assets/og-card.png">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {{ site.name }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="author" content="{{ site.author }}">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="/feed.xml">
</head>
<body>
  <header class="site-header">
    <a class="site-name" href="/">{{ site.name }}</a>
    <p class="site-subtitle">{{ site.subtitle }}</p>
    <nav class="site-nav">
      <a href="/">Articles</a>
      <a href="/about/">About</a>
    </nav>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p>&copy; {% year %} {{ site.author }} · <a href="/feed.xml">RSS</a></p>
  </footer>
</body>
</html>
