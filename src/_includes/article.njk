---
layout: base.njk
---
{% set shareUrl = site.url + page.url %}
<article class="article">
  <header class="article-header">
    <p class="article-meta">
      {% if category %}<span class="tag tag-{{ category | slugify }}">{{ category }}</span>{% endif %}
      <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
    </p>
    <h1>{{ title }}</h1>
    {% if summary %}<p class="article-standfirst">{{ summary }}</p>{% endif %}
  </header>

  <nav class="toc" aria-label="Contents" hidden>
    <div class="toc-inner">
      <p class="toc-label">Contents</p>
      <ol></ol>
    </div>
  </nav>

  <div class="article-body">
    {{ content | safe }}
  </div>

  <footer class="article-footer">
    <p class="share">
      <span class="share-label">Share</span>
      <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ shareUrl | urlencode }}" target="_blank" rel="noopener">LinkedIn</a>
      <a href="https://x.com/intent/post?url={{ shareUrl | urlencode }}&amp;text={{ title | urlencode }}" target="_blank" rel="noopener">X</a>
      <a href="mailto:?subject={{ title | urlencode }}&amp;body={{ shareUrl | urlencode }}">Email</a>
      <button type="button" class="share-copy" data-url="{{ shareUrl }}">Copy link</button>
    </p>
    <p class="article-next"><a href="/">&larr; All writing</a> <span aria-hidden="true">·</span> <a href="/about/#contact">Get in touch</a></p>
  </footer>
</article>
<script>
  // Margin contents list: built from the article's section headings.
  // Only shown for articles with 3+ sections, and only on wide screens (CSS).
  (function () {
    const nav = document.querySelector(".toc");
    const heads = [...document.querySelectorAll(".article-body h2")];
    if (!nav || heads.length < 3) return;
    const list = nav.querySelector("ol");
    const links = heads.map((h, i) => {
      if (!h.id) h.id = h.textContent.toLowerCase().trim().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "") || "section-" + (i + 1);
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = "#" + h.id;
      a.textContent = h.textContent;
      li.append(a);
      list.append(li);
      return a;
    });
    nav.hidden = false;
    // Highlight the section currently being read
    const update = () => {
      let current = 0;
      heads.forEach((h, i) => { if (h.getBoundingClientRect().top < window.innerHeight * 0.35) current = i; });
      links.forEach((a, i) => a.classList.toggle("is-current", i === current));
    };
    addEventListener("scroll", update, { passive: true });
    addEventListener("resize", update);
    update();
  })();

  document.querySelector(".share-copy")?.addEventListener("click", async (e) => {
    const b = e.currentTarget;
    try { await navigator.clipboard.writeText(b.dataset.url); b.textContent = "Link copied"; }
    catch { b.textContent = b.dataset.url; }
    setTimeout(() => (b.textContent = "Copy link"), 2500);
  });
</script>
