---
layout: base.njk
---
<section class="intro">
  <p>{{ site.description }}</p>
</section>

<section class="article-list">
  <h2 class="visually-hidden">Articles</h2>
  <ul>
    {% for article in collections.articles %}
    <li>
      <a class="article-list-title" href="{{ article.url }}">{{ article.data.title }}</a>
      <time class="article-list-date" datetime="{{ article.date | isoDate }}">{{ article.date | readableDate }}</time>
      {% if article.data.summary %}<p class="article-list-summary">{{ article.data.summary }}</p>{% endif %}
    </li>
    {% endfor %}
  </ul>
</section>
